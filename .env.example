# Copy this file to .env (`make up` does it if it is missing). .env is in .gitignore.
# These are credentials for local development ONLY; never use them in any other environment.

# --- Postgres ---
POSTGRES_PASSWORD=dev-postgres
VIGIA_OWNER_PASSWORD=dev-vigia-owner
VIGIA_APP_PASSWORD=dev-vigia-app
KEYCLOAK_DB_PASSWORD=dev-keycloak-db

# --- Keycloak ---
KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin
# Password of every test user in the vigia realm (rimac-admin, sin-org, ...)
VIGIA_DEV_USER_PASSWORD=dev-user

# --- Ports published on the host ---
# 5433 so as not to clash with a local Postgres on 5432
VIGIA_PG_PORT=5433
VIGIA_API_PORT=8000
VIGIA_KEYCLOAK_PORT=8080
VIGIA_DASHBOARD_PORT=4200
VIGIA_MAILPIT_UI_PORT=8025

# --- Backend ---
VIGIA_LOG_LEVEL=INFO

# --- Email alerts (dispatcher) ---
# Locally nothing is needed: Compose points the dispatcher at Mailpit (http://localhost:8025).
# Outside local, configure a real SMTP server and the public URL of the API (confirmation links):
# VIGIA_PUBLIC_URL=https://vigia.example.org
# VIGIA_SMTP_HOST=smtp.example.org
# VIGIA_SMTP_PORT=587
# VIGIA_SMTP_START_TLS=true
# VIGIA_SMTP_USERNAME=...
# VIGIA_SMTP_PASSWORD=...
# VIGIA_SMTP_FROM="Vigía <alertas@example.org>"

# --- Telegram (telegram worker and linking links) ---
# Create the bot with @BotFather on Telegram (/newbot). The token is a secret: only here, in your
# .env, never in the repository or in the chat. Without these variables, Telegram stays disabled.
# VIGIA_TELEGRAM_BOT_TOKEN=
# VIGIA_TELEGRAM_BOT_USERNAME=NombreDeTuBot
