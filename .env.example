# Copia este archivo a .env (`make up` lo hace si falta). .env está en .gitignore.
# Son credenciales SOLO de desarrollo local; nunca las uses en otro entorno.

# --- Postgres ---
POSTGRES_PASSWORD=dev-postgres
VIGIA_OWNER_PASSWORD=dev-vigia-owner
VIGIA_APP_PASSWORD=dev-vigia-app
KEYCLOAK_DB_PASSWORD=dev-keycloak-db

# --- Keycloak ---
KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin
# Contraseña de todos los usuarios de prueba del realm vigia (rimac-admin, sin-org, ...)
VIGIA_DEV_USER_PASSWORD=dev-user

# --- Puertos publicados en el host ---
# 5433 para no chocar con un Postgres local en 5432
VIGIA_PG_PORT=5433
VIGIA_API_PORT=8000
VIGIA_KEYCLOAK_PORT=8080
VIGIA_DASHBOARD_PORT=4200
VIGIA_MAILPIT_UI_PORT=8025

# --- Backend ---
VIGIA_LOG_LEVEL=INFO

# --- Alertas por correo (dispatcher) ---
# En local no hace falta nada: Compose apunta el dispatcher a Mailpit (http://localhost:8025).
# Fuera de local, configura un SMTP real y la URL pública de la API (enlaces de confirmación):
# VIGIA_PUBLIC_URL=https://vigia.example.org
# VIGIA_SMTP_HOST=smtp.example.org
# VIGIA_SMTP_PORT=587
# VIGIA_SMTP_START_TLS=true
# VIGIA_SMTP_USERNAME=...
# VIGIA_SMTP_PASSWORD=...
# VIGIA_SMTP_FROM="Vigía <alertas@example.org>"

# --- Telegram (worker telegram y enlaces de vinculación) ---
# Crea el bot con @BotFather en Telegram (/newbot). El token es un secreto: solo aquí, en tu
# .env, nunca en el repositorio ni en el chat. Sin estas variables, Telegram queda deshabilitado.
# VIGIA_TELEGRAM_BOT_TOKEN=
# VIGIA_TELEGRAM_BOT_USERNAME=NombreDeTuBot
