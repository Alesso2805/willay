{
  "components": {
    "schemas": {
      "GeoJsonGeometry": {
        "description": "Polygon (lo que dibuja el mapa) o MultiPolygon. Coordenadas [longitud, latitud].",
        "properties": {
          "coordinates": {
            "items": {},
            "title": "Coordinates",
            "type": "array"
          },
          "type": {
            "enum": [
              "Polygon",
              "MultiPolygon"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "coordinates"
        ],
        "title": "GeoJsonGeometry",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "keycloak_org_id": {
            "format": "uuid",
            "title": "Keycloak Org Id",
            "type": "string"
          },
          "organization_id": {
            "format": "uuid",
            "title": "Organization Id",
            "type": "string"
          },
          "permissions": {
            "description": "Para que el panel oculte acciones; la API las valida igual en cada endpoint.",
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "title": "Permissions",
            "type": "array"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "title": "Roles",
            "type": "array"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email",
          "full_name",
          "organization_id",
          "keycloak_org_id",
          "roles",
          "permissions"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "Permission": {
        "enum": [
          "view",
          "incidents:acknowledge",
          "incidents:resolve",
          "territory:manage",
          "rules:manage",
          "contacts:view_details",
          "contacts:manage",
          "policies:manage",
          "audit:view"
        ],
        "title": "Permission",
        "type": "string"
      },
      "ReadingBatchIn": {
        "additionalProperties": false,
        "properties": {
          "readings": {
            "items": {
              "$ref": "#/components/schemas/ReadingIn"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Readings",
            "type": "array"
          }
        },
        "required": [
          "readings"
        ],
        "title": "ReadingBatchIn",
        "type": "object"
      },
      "ReadingBatchOut": {
        "properties": {
          "duplicates": {
            "description": "Ya existían por (estación, measured_at); se ignoran.",
            "title": "Duplicates",
            "type": "integer"
          },
          "late": {
            "description": "De las guardadas, cuántas llegaron más de 1 h tarde: quedan en el historial pero no se evalúan. Muchas tardías suelen indicar un reloj o un enlace con problemas en la estación.",
            "title": "Late",
            "type": "integer"
          },
          "received": {
            "title": "Received",
            "type": "integer"
          },
          "stored": {
            "title": "Stored",
            "type": "integer"
          }
        },
        "required": [
          "received",
          "stored",
          "duplicates",
          "late"
        ],
        "title": "ReadingBatchOut",
        "type": "object"
      },
      "ReadingIn": {
        "additionalProperties": false,
        "properties": {
          "measured_at": {
            "format": "date-time",
            "title": "Measured At",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "measured_at",
          "value"
        ],
        "title": "ReadingIn",
        "type": "object"
      },
      "RiskLevel": {
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "RiskLevel",
        "type": "string"
      },
      "Role": {
        "enum": [
          "admin",
          "operator",
          "responder",
          "viewer"
        ],
        "title": "Role",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ZoneIn": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "geometry": {
            "$ref": "#/components/schemas/GeoJsonGeometry"
          },
          "is_active": {
            "default": true,
            "title": "Is Active",
            "type": "boolean"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "population_estimate": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Population Estimate"
          },
          "risk_level": {
            "$ref": "#/components/schemas/RiskLevel"
          }
        },
        "required": [
          "name",
          "risk_level",
          "geometry"
        ],
        "title": "ZoneIn",
        "type": "object"
      },
      "ZoneOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "geometry": {
            "additionalProperties": true,
            "description": "MultiPolygon GeoJSON",
            "title": "Geometry",
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "population_estimate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Population Estimate"
          },
          "risk_level": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "risk_level",
          "population_estimate",
          "is_active",
          "geometry",
          "created_at",
          "updated_at"
        ],
        "title": "ZoneOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "description": "API key de la estación: `<station_id>.<secreto>`",
        "in": "header",
        "name": "X-Api-Key",
        "type": "apiKey"
      },
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Vigía API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Usuario autenticado, su organización, roles y permisos",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/readings": {
      "post": {
        "operationId": "post_readings_v1_readings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingBatchIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingBatchOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "API key ausente o inválida"
          },
          "403": {
            "description": "Estación inactiva"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Más de 60 lotes por minuto; ver el header Retry-After"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Lote de lecturas de la estación dueña de la API key",
        "tags": [
          "ingestion"
        ]
      }
    },
    "/v1/zones": {
      "get": {
        "operationId": "list_zones_v1_zones_get",
        "parameters": [
          {
            "description": "incluir las desactivadas",
            "in": "query",
            "name": "include_inactive",
            "required": false,
            "schema": {
              "default": false,
              "description": "incluir las desactivadas",
              "title": "Include Inactive",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ZoneOut"
                  },
                  "title": "Response List Zones V1 Zones Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Zonas de la organización",
        "tags": [
          "territory"
        ]
      },
      "post": {
        "operationId": "post_zone_v1_zones_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ZoneIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZoneOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "Datos o geometría inválidos (el motivo va en el detalle)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Crear una zona",
        "tags": [
          "territory"
        ]
      }
    },
    "/v1/zones/{zone_id}": {
      "delete": {
        "operationId": "delete_zone_v1_zones__zone_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "zone_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Zone Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No existe"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Desactivar una zona (no se borra: la historia de sus incidentes se conserva)",
        "tags": [
          "territory"
        ]
      },
      "get": {
        "operationId": "get_zone_v1_zones__zone_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "zone_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Zone Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZoneOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No existe"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Una zona",
        "tags": [
          "territory"
        ]
      },
      "put": {
        "operationId": "put_zone_v1_zones__zone_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "zone_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Zone Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ZoneIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZoneOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No existe"
          },
          "422": {
            "description": "Datos o geometría inválidos"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Reemplazar una zona (atributos y geometría; también reactiva)",
        "tags": [
          "territory"
        ]
      }
    }
  }
}
