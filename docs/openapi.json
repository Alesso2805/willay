{
  "components": {
    "schemas": {
      "GeoJsonGeometry": {
        "description": "Polygon (lo que dibuja el mapa) o MultiPolygon. Coordenadas [longitud, latitud].",
        "properties": {
          "coordinates": {
            "items": {},
            "title": "Coordinates",
            "type": "array"
          },
          "type": {
            "enum": [
              "Polygon",
              "MultiPolygon"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "coordinates"
        ],
        "title": "GeoJsonGeometry",
        "type": "object"
      },
      "GeoJsonPoint": {
        "properties": {
          "coordinates": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "title": "Coordinates",
            "type": "array"
          },
          "type": {
            "const": "Point",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "coordinates"
        ],
        "title": "GeoJsonPoint",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HeartbeatOut": {
        "properties": {
          "last_measured_at": {
            "format": "date-time",
            "title": "Last Measured At",
            "type": "string"
          },
          "last_seen_at": {
            "format": "date-time",
            "title": "Last Seen At",
            "type": "string"
          },
          "last_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Value"
          }
        },
        "required": [
          "last_seen_at",
          "last_measured_at",
          "last_value"
        ],
        "title": "HeartbeatOut",
        "type": "object"
      },
      "IssuedKeyOut": {
        "properties": {
          "api_key": {
            "description": "Se muestra una sola vez; Vigía solo guarda su hash",
            "title": "Api Key",
            "type": "string"
          },
          "station": {
            "$ref": "#/components/schemas/StationOut"
          }
        },
        "required": [
          "station",
          "api_key"
        ],
        "title": "IssuedKeyOut",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "keycloak_org_id": {
            "format": "uuid",
            "title": "Keycloak Org Id",
            "type": "string"
          },
          "organization_id": {
            "format": "uuid",
            "title": "Organization Id",
            "type": "string"
          },
          "permissions": {
            "description": "Para que el panel oculte acciones; la API las valida igual en cada endpoint.",
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "title": "Permissions",
            "type": "array"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "title": "Roles",
            "type": "array"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email",
          "full_name",
          "organization_id",
          "keycloak_org_id",
          "roles",
          "permissions"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "Permission": {
        "enum": [
          "view",
          "incidents:acknowledge",
          "incidents:resolve",
          "territory:manage",
          "rules:manage",
          "contacts:view_details",
          "contacts:manage",
          "policies:manage",
          "audit:view"
        ],
        "title": "Permission",
        "type": "string"
      },
      "ReadingBatchIn": {
        "additionalProperties": false,
        "properties": {
          "readings": {
            "items": {
              "$ref": "#/components/schemas/ReadingIn"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Readings",
            "type": "array"
          }
        },
        "required": [
          "readings"
        ],
        "title": "ReadingBatchIn",
        "type": "object"
      },
      "ReadingBatchOut": {
        "properties": {
          "duplicates": {
            "description": "Ya existían por (estación, measured_at); se ignoran.",
            "title": "Duplicates",
            "type": "integer"
          },
          "late": {
            "description": "De las guardadas, cuántas llegaron más de 1 h tarde: quedan en el historial pero no se evalúan. Muchas tardías suelen indicar un reloj o un enlace con problemas en la estación.",
            "title": "Late",
            "type": "integer"
          },
          "received": {
            "title": "Received",
            "type": "integer"
          },
          "stored": {
            "title": "Stored",
            "type": "integer"
          }
        },
        "required": [
          "received",
          "stored",
          "duplicates",
          "late"
        ],
        "title": "ReadingBatchOut",
        "type": "object"
      },
      "ReadingIn": {
        "additionalProperties": false,
        "properties": {
          "measured_at": {
            "format": "date-time",
            "title": "Measured At",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "measured_at",
          "value"
        ],
        "title": "ReadingIn",
        "type": "object"
      },
      "RiskLevel": {
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "RiskLevel",
        "type": "string"
      },
      "Role": {
        "enum": [
          "admin",
          "operator",
          "responder",
          "viewer"
        ],
        "title": "Role",
        "type": "string"
      },
      "Source": {
        "enum": [
          "sensor",
          "simulator"
        ],
        "title": "Source",
        "type": "string"
      },
      "StationBodyIn": {
        "additionalProperties": false,
        "description": "Lo editable. El código no está: se fija al crear y no cambia.",
        "properties": {
          "expected_interval_s": {
            "maximum": 86400.0,
            "minimum": 5.0,
            "title": "Expected Interval S",
            "type": "integer"
          },
          "location": {
            "$ref": "#/components/schemas/GeoJsonPoint"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "silence_multiplier": {
            "default": 3,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Silence Multiplier",
            "type": "integer"
          },
          "source": {
            "$ref": "#/components/schemas/Source",
            "default": "sensor"
          },
          "status": {
            "$ref": "#/components/schemas/StationStatus",
            "default": "active"
          },
          "variable": {
            "$ref": "#/components/schemas/Variable"
          },
          "zones": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ZoneAssignmentIn"
            },
            "maxItems": 50,
            "title": "Zones",
            "type": "array"
          }
        },
        "required": [
          "name",
          "variable",
          "location",
          "expected_interval_s"
        ],
        "title": "StationBodyIn",
        "type": "object"
      },
      "StationCreateIn": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "examples": [
              "RIM-CHA-01"
            ],
            "maxLength": 32,
            "minLength": 2,
            "title": "Code",
            "type": "string"
          },
          "expected_interval_s": {
            "maximum": 86400.0,
            "minimum": 5.0,
            "title": "Expected Interval S",
            "type": "integer"
          },
          "location": {
            "$ref": "#/components/schemas/GeoJsonPoint"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "silence_multiplier": {
            "default": 3,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Silence Multiplier",
            "type": "integer"
          },
          "source": {
            "$ref": "#/components/schemas/Source",
            "default": "sensor"
          },
          "status": {
            "$ref": "#/components/schemas/StationStatus",
            "default": "active"
          },
          "variable": {
            "$ref": "#/components/schemas/Variable"
          },
          "zones": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ZoneAssignmentIn"
            },
            "maxItems": 50,
            "title": "Zones",
            "type": "array"
          }
        },
        "required": [
          "name",
          "variable",
          "location",
          "expected_interval_s",
          "code"
        ],
        "title": "StationCreateIn",
        "type": "object"
      },
      "StationOut": {
        "properties": {
          "api_key_rotated_at": {
            "format": "date-time",
            "title": "Api Key Rotated At",
            "type": "string"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expected_interval_s": {
            "title": "Expected Interval S",
            "type": "integer"
          },
          "has_zone": {
            "description": "Sin zona, la estación no genera alertas",
            "title": "Has Zone",
            "type": "boolean"
          },
          "heartbeat": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HeartbeatOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "location": {
            "additionalProperties": true,
            "description": "GeoJSON Point [lon, lat]",
            "title": "Location",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "silence_multiplier": {
            "title": "Silence Multiplier",
            "type": "integer"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "status": {
            "$ref": "#/components/schemas/StationStatus"
          },
          "unit": {
            "description": "Fija por variable: discharge m3/s, water_level m, rainfall mm",
            "title": "Unit",
            "type": "string"
          },
          "variable": {
            "$ref": "#/components/schemas/Variable"
          },
          "zones": {
            "items": {
              "$ref": "#/components/schemas/ZoneAssignmentIn"
            },
            "title": "Zones",
            "type": "array"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "variable",
          "unit",
          "location",
          "source",
          "expected_interval_s",
          "silence_multiplier",
          "status",
          "zones",
          "has_zone",
          "heartbeat",
          "api_key_rotated_at",
          "created_at"
        ],
        "title": "StationOut",
        "type": "object"
      },
      "StationStatus": {
        "enum": [
          "active",
          "inactive"
        ],
        "title": "StationStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Variable": {
        "enum": [
          "water_level",
          "discharge",
          "rainfall"
        ],
        "title": "Variable",
        "type": "string"
      },
      "ZoneAssignmentIn": {
        "additionalProperties": false,
        "properties": {
          "position": {
            "$ref": "#/components/schemas/ZonePosition"
          },
          "zone_id": {
            "format": "uuid",
            "title": "Zone Id",
            "type": "string"
          }
        },
        "required": [
          "zone_id",
          "position"
        ],
        "title": "ZoneAssignmentIn",
        "type": "object"
      },
      "ZoneIn": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "geometry": {
            "$ref": "#/components/schemas/GeoJsonGeometry"
          },
          "is_active": {
            "default": true,
            "title": "Is Active",
            "type": "boolean"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "population_estimate": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Population Estimate"
          },
          "risk_level": {
            "$ref": "#/components/schemas/RiskLevel"
          }
        },
        "required": [
          "name",
          "risk_level",
          "geometry"
        ],
        "title": "ZoneIn",
        "type": "object"
      },
      "ZoneOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "geometry": {
            "additionalProperties": true,
            "description": "MultiPolygon GeoJSON",
            "title": "Geometry",
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "population_estimate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Population Estimate"
          },
          "risk_level": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "risk_level",
          "population_estimate",
          "is_active",
          "geometry",
          "created_at",
          "updated_at"
        ],
        "title": "ZoneOut",
        "type": "object"
      },
      "ZonePosition": {
        "enum": [
          "upstream",
          "in_zone",
          "downstream"
        ],
        "title": "ZonePosition",
        "type": "string"
      }
