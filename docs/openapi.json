    "securitySchemes": {
      "APIKeyHeader": {
        "description": "API key de la estación: `<station_id>.<secreto>`",
        "in": "header",
        "name": "X-Api-Key",
        "type": "apiKey"
      },
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Vigía API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Usuario autenticado, su organización, roles y permisos",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/readings": {
      "post": {
        "operationId": "post_readings_v1_readings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingBatchIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingBatchOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "API key ausente o inválida"
          },
          "403": {
            "description": "Estación inactiva"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Más de 60 lotes por minuto; ver el header Retry-After"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Lote de lecturas de la estación dueña de la API key",
        "tags": [
          "ingestion"
        ]
      }
    },
    "/v1/stations": {
      "get": {
        "operationId": "list_stations_v1_stations_get",
        "parameters": [
          {
            "description": "incluir las desactivadas",
            "in": "query",
            "name": "include_inactive",
            "required": false,
            "schema": {
              "default": false,
              "description": "incluir las desactivadas",
              "title": "Include Inactive",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/StationOut"
                  },
                  "title": "Response List Stations V1 Stations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Estaciones de la organización",
        "tags": [
          "territory"
        ]
      },
      "post": {
        "operationId": "post_station_v1_stations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StationCreateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedKeyOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Código repetido"
          },
          "422": {
            "description": "Datos inválidos"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Crear una estación (devuelve su API key una sola vez)",
        "tags": [
          "territory"
        ]
      }
    },
    "/v1/stations/{station_id}": {
      "delete": {
        "operationId": "delete_station_v1_stations__station_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "station_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Station Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No existe"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Desactivar una estación (sus lotes reciben 403; la historia se conserva)",
        "tags": [
          "territory"
        ]
      },
      "get": {
        "operationId": "get_station_v1_stations__station_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "station_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Station Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No existe"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Una estación",
        "tags": [
          "territory"
        ]
      },
      "put": {
        "operationId": "put_station_v1_stations__station_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "station_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Station Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StationBodyIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
