{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "keycloak_org_id": {
            "format": "uuid",
            "title": "Keycloak Org Id",
            "type": "string"
          },
          "organization_id": {
            "format": "uuid",
            "title": "Organization Id",
            "type": "string"
          },
          "permissions": {
            "description": "Para que el panel oculte acciones; la API las valida igual en cada endpoint.",
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "title": "Permissions",
            "type": "array"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "title": "Roles",
            "type": "array"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email",
          "full_name",
          "organization_id",
          "keycloak_org_id",
          "roles",
          "permissions"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "Permission": {
        "enum": [
          "view",
          "incidents:acknowledge",
          "incidents:resolve",
          "territory:manage",
          "rules:manage",
          "contacts:view_details",
          "contacts:manage",
          "policies:manage",
          "audit:view"
        ],
        "title": "Permission",
        "type": "string"
      },
      "ReadingBatchIn": {
        "additionalProperties": false,
        "properties": {
          "readings": {
            "items": {
              "$ref": "#/components/schemas/ReadingIn"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Readings",
            "type": "array"
          }
        },
        "required": [
          "readings"
        ],
        "title": "ReadingBatchIn",
        "type": "object"
      },
      "ReadingBatchOut": {
        "properties": {
          "duplicates": {
            "description": "Ya existían por (estación, measured_at); se ignoran.",
            "title": "Duplicates",
            "type": "integer"
          },
          "late": {
            "description": "De las guardadas, cuántas llegaron más de 1 h tarde: quedan en el historial pero no se evalúan. Muchas tardías suelen indicar un reloj o un enlace con problemas en la estación.",
            "title": "Late",
            "type": "integer"
          },
          "received": {
            "title": "Received",
            "type": "integer"
          },
          "stored": {
            "title": "Stored",
            "type": "integer"
          }
        },
        "required": [
          "received",
          "stored",
          "duplicates",
          "late"
        ],
        "title": "ReadingBatchOut",
        "type": "object"
      },
      "ReadingIn": {
        "additionalProperties": false,
        "properties": {
          "measured_at": {
            "format": "date-time",
            "title": "Measured At",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "measured_at",
          "value"
        ],
        "title": "ReadingIn",
        "type": "object"
      },
      "Role": {
        "enum": [
          "admin",
          "operator",
          "responder",
          "viewer"
        ],
        "title": "Role",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "description": "API key de la estación: `<station_id>.<secreto>`",
        "in": "header",
        "name": "X-Api-Key",
        "type": "apiKey"
      },
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Vigía API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Usuario autenticado, su organización, roles y permisos",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/readings": {
      "post": {
        "operationId": "post_readings_v1_readings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingBatchIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingBatchOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "API key ausente o inválida"
          },
          "403": {
            "description": "Estación inactiva"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Más de 60 lotes por minuto; ver el header Retry-After"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Lote de lecturas de la estación dueña de la API key",
        "tags": [
          "ingestion"
        ]
      }
    }
  }
}
